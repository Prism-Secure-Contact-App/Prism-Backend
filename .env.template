# --- MATRIX SYNAPSE DEPLOYMENT CONFIGURATION ---

# 1. Database Configuration
# Postgres için güçlü bir şifre belirleyin.
POSTGRES_PASSWORD=SifreniziBurayaYaziniz

# 2. Cloudflare Tunnel Configuration
# Cloudflare Zero Trust panelinden aldığınız Tunnel Token'ı buraya yapıştırın.
TUNNEL_TOKEN=cloudflare_tunnel_token_buraya

# 3. Synapse Configuration
# Matrix sunucu adınız (Örn: matrix.alanadiniz.com)
SERVER_NAME=matrix.alanadiniz.com
REPORT_STATS=yes

# 4. Raspberry Pi SSH (deploy_whatsapp_bridge.py için)
PI_HOST=100.125.63.77
PI_USER=pi
PI_PASS=SifreniziBurayaYaziniz
MATRIX_DIR=/opt/matrix-server

# 5. Lightning (Breez SDK)
# https://breez.technology adresinden API key alın.
BREEZ_API_KEY=
