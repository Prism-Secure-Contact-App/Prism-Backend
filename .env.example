# =============================================================================
# PRISM Backend - Ortam Değişkenleri
# =============================================================================
# Bu dosyayı .env olarak kopyalayın ve değerleri kendinize göre doldurun:
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# 1. Temel Sunucu Ayarları
# ---------------------------------------------------------------------------

# Web sitesi ana domaini (örn: prismas.net)
DOMAIN=prismas.net

# Matrix sunucu domaini (örn: matrix.alanadiniz.com)
# Eğer Matrix sunucunuz web sitenizin alt domainindeyse: matrix.alanadiniz.com
MATRIX_DOMAIN=matrix.alanadiniz.com

# Matrix sunucu adı (örn: matrix.alanadiniz.com)
SERVER_NAME=matrix.alanadiniz.com

# Sunucunun görünen ismi
SERVER_DISPLAY_NAME=PRISM Messenger

# Halka açık kayıt (ilk etapta kapalı tutmanız önerilir: no)
ENABLE_REGISTRATION=no

# ---------------------------------------------------------------------------
# 2. PostgreSQL Veritabanı
# ---------------------------------------------------------------------------

POSTGRES_DB=synapse
POSTGRES_USER=synapse

# Çok güçlü ve benzersiz bir şifre belirleyin!
POSTGRES_PASSWORD=DegistirinGucluBirSifre123!

# ---------------------------------------------------------------------------
# 3. Cloudflare Tunnel
# ---------------------------------------------------------------------------

# Cloudflare Zero Trust panelinden aldığınız tunnel token
TUNNEL_TOKEN=cloudflare_tunnel_token_buraya

# ---------------------------------------------------------------------------
# 4. Yönetici Kullanıcı
# ---------------------------------------------------------------------------

ADMIN_USER=@admin:matrix.alanadiniz.com

# ---------------------------------------------------------------------------
# 5. Monero Node (monerod)
# ---------------------------------------------------------------------------

# Monero veri dizini boyutu: pruned node ~95-120 GB disk kullanır.
# Full node istiyorsanız --prune-blockchain parametresini docker-compose.yml'den kaldırın
# ve en az 400 GB disk ayırın.
MONERO_PRUNE=true

# ---------------------------------------------------------------------------
# 6. AI Relay (WhatsApp/Meta AI entegrasyonu) - opsiyonel
# ---------------------------------------------------------------------------

# Matrix bot kullanıcısı (örn: @metai:matrix.alanadiniz.com)
MATRIX_AI_USER=@metai:matrix.alanadiniz.com
MATRIX_AI_PASSWORD=bot_sifresi_buraya
META_AI_ROOM_NAME=Meta AI

# ---------------------------------------------------------------------------
# 7. Lightning / Breez SDK (Gelecekte kullanılmak üzere)
# ---------------------------------------------------------------------------

BREEZ_API_KEY=

# ---------------------------------------------------------------------------
# 8. Log Seviyeleri
# ---------------------------------------------------------------------------

LOG_LEVEL=INFO
